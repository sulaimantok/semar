# Copy to .env (never commit .env). Development values only.
POSTGRES_USER=semar
POSTGRES_PASSWORD=change-me
SEMAR_TEMPORAL_NAMESPACE=semar
# 32-byte AES key for the Temporal payload codec, base64-encoded:
#   openssl rand -base64 32
SEMAR_PAYLOAD_KEY_ID=k1
SEMAR_PAYLOAD_KEY=
# Rotation: set a new KEY_ID/KEY and keep old keys here until no workflow or
# schedule payload encrypted with them remains, e.g. k1=<base64>
SEMAR_PAYLOAD_PREVIOUS_KEYS=
