# Copy to .env (never commit .env). Development values only.
POSTGRES_USER=semar
POSTGRES_PASSWORD=change-me
SEMAR_TEMPORAL_NAMESPACE=semar
# Password of the "admin" user created on first start (min. 12 characters).
# Remove after the first login; it is ignored once any user exists.
SEMAR_BOOTSTRAP_ADMIN_PASSWORD=
# Key-encryption key sealing provider credentials (32 bytes, base64):
#   openssl rand -base64 32
# Rotation: set a new SEMAR_KEK_ID/SEMAR_KEK, move the old key to
# SEMAR_KEK_PREVIOUS (e.g. k1=<base64>), run `semar-api kek-rewrap`, then
# remove the old key.
SEMAR_KEK_ID=k1
SEMAR_KEK=
SEMAR_KEK_PREVIOUS=
# 32-byte AES key for the Temporal payload codec, base64-encoded:
#   openssl rand -base64 32
SEMAR_PAYLOAD_KEY_ID=k1
SEMAR_PAYLOAD_KEY=
# Rotation: set a new KEY_ID/KEY and keep old keys here until no workflow or
# schedule payload encrypted with them remains, e.g. k1=<base64>
SEMAR_PAYLOAD_PREVIOUS_KEYS=
# Directory of extra CA certificates (PEM, one per file) to trust for
# provider endpoints signed by a private CA. Defaults to ./extra-ca.
# SEMAR_EXTRA_CA_DIR=/path/to/ca-dir
